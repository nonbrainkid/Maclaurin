# Скопировать в .env и заполнить. .env в git не попадает (см. .gitignore).
#
#   Copy-Item .env.example .env
#
# forge и cast подхватывают .env из корня проекта сами — `source .env`
# (которого в PowerShell и нет) не требуется.
#
# СЕТЬ ЗАПУСКА: Robinhood Chain (Arbitrum L2, газ в ETH).
#   mainnet  chain ID 4663   https://robinhoodchain.blockscout.com
#   testnet  chain ID 46630  https://explorer.testnet.chain.robinhood.com
#
# ПРИВАТНОГО КЛЮЧА ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО.
# .env читает всё, что запускается в проекте: любой скрипт, любая зависимость,
# любое расширение редактора. Ключ хранится в зашифрованном keystore:
#
#   cast wallet import maclaurin-deployer --interactive
#
# и передаётся в команды как `--account maclaurin-deployer`. Подробности —
# DEPLOY-RUNBOOK.md §2. Для мейннета также годятся --ledger / --trezor.
#
# Официальный туториал Robinhood Chain предлагает `export PRIVATE_KEY=0x...`.
# Так делать не надо: ключ попадёт в переменные окружения, в историю оболочки
# и в список процессов. Отозвать приватный ключ нельзя — кошелёк придётся
# считать скомпрометированным навсегда.

# --- Адреса (оба immutable после деплоя) ---

# Получатель GENESIS (2 000 000 000 MACLRN). Отсюда пойдёт ликвидность в пул
# и отсюда же берутся токены для ручной проверки стейкинга в тестнете.
GENESIS_RECIPIENT=0x

# Казна остаточного члена Лагранжа. Адрес immutable — после деплоя не меняется.
# Сюда уходит награда эпох, в которые никто не стейкал, и награда, сгоревшая
# при досрочном выходе из лока.
REMAINDER_VAULT=0x

# --- Запуск фазы 4 (script/Launch.s.sol, PHASE4-SPEC.md §7) ---
# ОДИН прогон разворачивает MaclaurinVesting, затем MaclaurinCurve, затем
# раскладывает genesis. Разносить эти шаги по отдельным командам НЕЛЬЗЯ: окно
# анти-снайпа кривой (ANTI_SNIPE_WINDOW = 1 час) стартует в её конструкторе, а
# продавать ей нечего до прихода инвентаря. Час паузы между двумя шагами — и
# лимит §4.5 не сработает ни разу. Подробности — DEPLOY-RUNBOOK.md §12.
#
# Прогон подписывает GENESIS_RECIPIENT: он же разворачивает оба контракта, он
# же раздаёт доли. Значит на нём должен быть газ.
#
# Кому откроется казна после разблокировки. immutable, сменить нельзя.
# VESTING_BENEFICIARY=0x
#
# Кому идёт 1% комиссии кривой (в ETH). immutable, сменить нельзя.
# FEE_RECIPIENT=0x
#
# Когда откроется казна (unix-время). По §6 — ровно конец эмиссии,
# startTime + 175 дней. Считать не в уме, а с цепочки:
#   cast call $EMISSION "emissionEnd()(uint256)" --rpc-url $RPC
# (у вывода cast есть хвост вида `[1.8e9]` — в .env идёт только число).
# VESTING_UNLOCK_TIME=
#
# Адрес уже развёрнутой MaclaurinEmission. Необязателен, но задать стоит:
# скрипт сверяет с ним VESTING_UNLOCK_TIME точным равенством, а адрес эмиссии
# — единственный источник этой даты, который нельзя набрать с опечаткой.
# MACLAURIN_EMISSION=0x

# --- Раскладка genesis (script/Distribute.s.sol, PHASE4-SPEC.md §7) ---
# Distribute вызывается из Launch и отдельной командой обычно не нужен. Сам по
# себе он полезен только для проверки уже случившейся раскладки:
#   forge script script/Distribute.s.sol --sig "verify()" --rpc-url rh
#
# Отправитель раскладки — GENESIS_RECIPIENT выше: скрипт требует, чтобы на нём
# лежало РОВНО 2 000 000 000 MACLRN, и после раздачи проверяет, что стало ноль.
# Адрес токена берётся из MACLAURIN_TOKEN — той же переменной, что у пула ниже.
#
# АДРЕСА СЖИГАНИЯ ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО. 0x…dEaD — константа в байткоде
# скрипта. Настраиваемый «адрес сжигания» — известный способ оставить себе
# 9.2% сапплая, не поменяв в документации ни строчки.
#
# MACLAURIN_CURVE и MACLAURIN_VESTING — это ВЫХОД Launch, а не вход: он их
# разворачивает сам и печатает готовые строки в конце прогона. Заполнить их
# здесь надо ПОСЛЕ запуска, чтобы работали verify() и команды §12.
#
# MACLAURIN_CURVE=0x        # 1 000 000 000 — инвентарь бондинг-кривой
# MACLAURIN_VESTING=0x      #   500 000 000 — казна под замком
# MARKETING_WALLET=0x    #   125 000 000 — маркетинг и эйрдропы
# RESERVE_WALLET=0x      #    62 500 000 — резерв
#                        #    62 500 000 — остаточный член, REMAINDER_VAULT выше
#                        #   250 000 000 — сжигается в 0x…dEaD
#
# Ожидаемая дата разблокировки казны (unix-время) — сверяется с фактическим
# unlockTime развёрнутого MaclaurinVesting точным равенством. Скрипт и без неё
# требует, чтобы дата была в будущем, но промах на год ловится только сверкой
# с заранее посчитанным значением, а после перевода 500 миллионов исправлять
# уже нечего: контракт неизменяем. Посчитать: startTime эмиссии + 175 дней,
#   cast call $EMISSION "startTime()(uint256)"
# Не задана — сверка пропускается, а фактическая дата печатается в лог, чтобы
# её увидел человек. Для мейннета лучше задать — в паре с VESTING_UNLOCK_TIME
# это две независимо набранные записи одной и той же даты.
# EXPECTED_UNLOCK_TIME=

# --- Тайминг ---

# Задержка старта эпохи 2 в секундах от момента деплоя.
# Deploy.s.sol не даст поставить меньше 300 (MIN_START_DELAY): при нулевой
# задержке startTime, посчитанный в симуляции, окажется в прошлом относительно
# реального блока, и конструктор отревертит StartTimeInPast.
#
#   ТЕСТНЕТ  -> 300    эмиссия стартует сразу, награда начинает капать через
#                      пять минут, и earned() не сидит в честном нуле сутки.
#   МЕЙННЕТ  -> 86400  сутки запаса, чтобы успеть собрать пул ликвидности
#                      ДО начала эмиссии.
#
# На длительность локов эта переменная не влияет никак: лок = R × 7 дней,
# EPOCH_DURATION — constant в байткоде и не настраивается.
EMISSION_START_DELAY=300

# --- Сеть ---
# Публичные RPC, ключ и регистрация не нужны. Проверены живыми 2026-08-01:
# cast chain-id возвращает 4663 и 46630, клиент nitro/v3.11.3.
# Публичные эндпоинты рейт-лимитированы; при упоре в лимит у сети есть
# бесплатные ключи Alchemy, а также QuickNode, dRPC, Blockdaemon.
#
# Чтобы писать `--rpc-url rh` вместо полного URL, добавь в foundry.toml:
#   [rpc_endpoints]
#   rh         = "${RH_RPC_URL}"
#   rh_testnet = "${RH_TESTNET_RPC_URL}"
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Верификация ---
# API-КЛЮЧ НЕ НУЖЕН. Robinhood Chain индексируется Blockscout, он принимает
# верификацию без ключа и без аккаунта. Старая строка BASESCAN_API_KEY
# относилась к Etherscan API V2 и к сети Base — здесь она не используется.
# Верификатор задаётся флагами прямо в команде (DEPLOY-RUNBOOK.md §5):
#   --verifier blockscout --verifier-url https://robinhoodchain.blockscout.com/api/
# Косая черта на конце обязательна.
#
# Верифицировать нужно ДВА контракта: MaclaurinEmission и MaclaurinToken.
# Второй разворачивается из конструктора первого, поэтому у него нет
# транзакции создания и автоверификация на нём не срабатывает.

# --- Пул ликвидности (script/Pool.s.sol, этап мейннета) ---
# Заполняется уже после деплоя, когда известен адрес токена.
# Подробности и обоснование чисел — DEPLOY-RUNBOOK.md §8.
#
# ВНИМАНИЕ: Uniswap в ТЕСТНЕТЕ Robinhood Chain НЕ РАЗВЁРНУТ (проверено
# cast code 2026-08-01: ни фабрики, ни NPM, ни WETH). Пул репетируется
# только на локальном форке мейннета — DEPLOY-RUNBOOK.md §8.0.
#
# MACLAURIN_TOKEN=0x
# MACLAURIN_AMOUNT=200000000000000000000000000   # 200 000 000 × 1e18 (10% genesis)
# ETH_AMOUNT=7000000000000000                 # 0.0070 ETH
# POOL_FEE=10000                              # 1% — тир для волатильной экзотики
# LP_MIN_BPS=0
# LP_TOKEN_ID=
# LP_EXPECT_FULL_RANGE=true
# BURN_CONFIRM=                               # "BURN" — только для сжигания LP, НЕОБРАТИМО
#
# Адреса Uniswap V3 на Robinhood Chain mainnet (chain ID 4663), сверены on-chain.
# Pool.s.sol подставляет их сам по chainid; переменные ниже — только для override.
# WETH ЗДЕСЬ НЕ 0x4200...0006 — это Arbitrum, а не OP Stack. Захардкоженный
# OP-Stack-адрес означает потерю средств.
# UNISWAP_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
# UNISWAP_NPM=0x73991a25c818bf1f1128deaab1492d45638de0d3
# UNISWAP_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
