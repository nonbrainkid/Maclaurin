pragma solidity =0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title  MaclaurinCurve
 * @notice Механизм ПЕРВИЧНОЙ ПРОДАЖИ $MACLRN с гарантией возврата денег.
 *         Кривая держит инвентарь токенов и резерв ETH, продаёт по растущей
 *         цене и выкупает купленное обратно по той же самой цене. Ликвидность
 *         не заводится капиталом — она возникает из денег покупателей и уходит
 *         вместе с ними.
 *
 *         ЭТО НЕ БИРЖА, и путать эти две роли опасно. Кривая выкупает у
 *         каждого адреса ровно столько, сколько он у неё купил (`boughtOf`),
 *         и ни токеном больше. Токены, полученные НЕ от кривой — награды
 *         стейкинга из MaclaurinEmission, доли genesis (маркетинг, резерв,
 *         казна), покупка у другого держателя — продать в кривую нельзя, и
 *         это не ограничение, а условие того, что резерв вообще принадлежит
 *         покупателям. Разбор атаки, которая была бы возможна иначе, — над
 *         `sell()`. Вторичный рынок — это DEX, а не этот контракт.
 *
 *         Цена линейна по количеству уже проданного:
 *
 *             p(x) = P0 + K·x,   K = SLOPE / INVENTORY
 *
 *         а стоимость сделки — площадь трапеции под этой прямой. Только
 *         умножение и деление целых чисел, ни одного приближения (PHASE4-SPEC
 *         §2.1: экспонента отвергнута, потому что её нельзя проверить в уме,
 *         а проект держится на «это не обещание, это арифметика»).
 *
 *         ГДЕ ЗДЕСЬ e. Коэффициенты подобраны так, что при распродаже всего
 *         инвентаря цена вырастает РОВНО в e раз:
 *
 *             p(INVENTORY) · 1e18 / p(0) == E_FIXED,  без остатка
 *
 *         Это проверяется одним делением на цепочке, а не на слово. Побочно
 *         вышло второе точное равенство: весь инвентарь стоит ровно
 *         (1 + e) ETH == E_FIXED + 1e18 wei (см. TOTAL_RAISE).
 *
 * @dev    БЕЗОПАСНОСТЬ. Как и в остальных контрактах проекта, главное здесь —
 *         чего в контракте НЕТ: нет owner и ролей, нет паузы, нет апгрейда,
 *         нет функции спасения токенов или ETH, нет receive/fallback, нет
 *         ни одной функции, способной тронуть `reserve` иначе как через
 *         продажу токенов обратно в кривую.
 *
 *         КОМИССИЯ НИКОГДА НЕ БЕРЁТСЯ ИЗ РЕЗЕРВА (§3, §4.1). При покупке она
 *         изымается ДО зачисления в резерв, при продаже — из суммы, уже
 *         вычтенной из резерва. `reserve` и `feesAccrued` — раздельные
 *         счётчики, и ни одна строка их не смешивает. Ошибка здесь не видна
 *         сразу: резерв опустеет только к моменту, когда последний держатель
 *         попробует продать, и его транзакция будет реветить вечно.
 *
 *         НИКАКИХ РАСЧЁТОВ ОТ `address(this).balance` (§4.2). Любой может
 *         прислать ETH принудительно (selfdestruct долетает и без receive),
 *         и если бы резерв читался как баланс, донат двигал бы цену. Баланс
 *         не участвует ни в одном расчёте — только явные счётчики. То же
 *         правило уже действует в MaclaurinEmission относительно balanceOf.
 *
 *         ОКРУГЛЕНИЕ ВСЕГДА В ПОЛЬЗУ ПРОТОКОЛА (§4.6), и это не про копейки,
 *         а про доказуемость платёжеспособности. Покупка платит ВВЕРХ
 *         (`_costCeil`), продажа получает ВНИЗ (`_costFloor`). Поэтому после
 *         любой последовательности сделок выполняется
 *
 *             reserve ≥ A(0, sold)
 *
 *         где A — точная (рациональная, без округлений) площадь под кривой.
 *         Площадь аддитивна, а обе границы округляются в одну сторону, так
 *         что неравенство переживает любое дробление сделок. Выплатить
 *         больше, чем лежит в резерве, невозможно арифметически.
 *
 *         ПОКУПАТЕЛЬ ВСЕГДА МОЖЕТ ВЫЙТИ (§4.7). У `sell` нет ни одного
 *         условия сверх арифметически необходимых: продавать можно ровно то,
 *         что куплено у кривой, выплата не ниже minEthOut, дедлайн не истёк.
 *         Ни паузы, ни белых/чёрных списков, ни кулдауна, ни налога на
 *         продажу, ни зависимости от чьего-либо решения. Обратное —
 *         определение honeypot, и это первое, что проверяет покупатель.
 */
contract MaclaurinCurve is ReentrancyGuard {
    using SafeERC20 for IERC20;

    /*//////////////////////////////////////////////////////////////
                           КОНСТАНТЫ КРИВОЙ
    //////////////////////////////////////////////////////////////*/

    /// @notice Инвентарь кривой: 1 000 000 000 токенов (§7, доля 1/2 genesis).
    ///         Он же верхняя граница `sold` и области определения цены.
    uint256 public constant INVENTORY = 1_000_000_000e18;

    /// @notice floor(e × 1e18). Та же константа, что в MaclaurinEmission.
    uint256 public constant E_FIXED = 2_718_281_828_459_045_235;

    /**
     * @notice Цена в точке 0, в ценовых единицах за один wei токена.
     *
     * @dev ПОЧЕМУ ИМЕННО 2e17. Требование §2.2 — отношение цен на концах
     *      кривой должно быть РОВНО e, то есть p(S)·1e18 / p(0) == E_FIXED
     *      без остатка. Значит p(0)·E_FIXED обязано делиться на 1e18.
     *      E_FIXED = 5 × 543656365691809047, а 1e18 = 2^18 · 5^18, поэтому
     *      общий делитель — ровно 5, и минимальное p(0), дающее ТОЧНОЕ
     *      равенство, есть 1e18 / 5 = 2e17. Любое меньшее значение уводит
     *      отношение от e в последних разрядах, и тезис проекта перестаёт
     *      быть проверяемым.
     *
     *      Отсюда же понятно, зачем нужен PRICE_SCALE: 2e17 wei за один wei
     *      токена — абсурдная цена, поэтому «ценовая единица» здесь мельче
     *      wei в PRICE_SCALE раз, а деление на этот масштаб происходит ровно
     *      один раз, в самом конце расчёта стоимости.
     */
    uint256 public constant P0 = 200_000_000_000_000_000;

    /**
     * @notice Цена в точке INVENTORY. Ровно P0 × e.
     * @dev P0 · E_FIXED / 1e18 = 2e17 · 2718281828459045235 / 1e18
     *      = 2718281828459045235 / 5 = 543656365691809047, деление точное.
     */
    uint256 public constant P_FINAL = 543_656_365_691_809_047;

    /**
     * @notice Числитель наклона: p(x) = P0 + SLOPE·x / INVENTORY.
     *
     * @dev Сам K = SLOPE / INVENTORY ≈ 3.4e-10 — целым числом не выражается
     *      вообще, поэтому в контракте хранится числитель, а деление на
     *      INVENTORY «сливается» с итоговым делением в формуле площади.
     *      Требование §2.2 «не вычислять K в конструкторе делением» здесь
     *      выполнено сильнее, чем просили: K не вычисляется НИГДЕ и никогда,
     *      ни в конструкторе, ни в рантайме — есть только точная разность
     *      P_FINAL − P0, посчитанная офчейн и сверяемая тестом.
     */
    uint256 public constant SLOPE = P_FINAL - P0;

    /// @notice Масштаб ценовой единицы: 1 wei ETH == PRICE_SCALE ценовых единиц.
    /// @dev Отсюда стартовая цена одного целого токена — P0·1e18/PRICE_SCALE
    ///      = 2 gwei, конечная — 5.436563656 gwei.
    uint256 private constant PRICE_SCALE = 1e26;

    /// @dev Числитель площади трапеции: (x2−x1)·(COST_BASE + SLOPE·(x1+x2)),
    ///      знаменатель COST_DENOM. Обе константы вычислены компилятором из
    ///      значений выше, руками здесь не написано ни одной цифры.
    uint256 private constant COST_BASE = 2 * P0 * INVENTORY; //     4e44
    uint256 private constant COST_DENOM = 2 * INVENTORY * PRICE_SCALE; // 2e53

    /**
     * @notice Стоимость всего инвентаря: ровно (1 + e) ETH.
     *
     * @dev Не подгонка, а следствие выбора P0 и PRICE_SCALE:
     *      A(0,S) = S·(2·P0 + SLOPE)/(2·PRICE_SCALE)
     *             = 1e27 · 743656365691809047 / 2e26
     *             = 3 718 281 828 459 045 235 wei == E_FIXED + 1e18.
     *      Деление точное, остатка нет — проверяется тестом.
     */
    uint256 public constant TOTAL_RAISE = E_FIXED + 1e18;

    /*//////////////////////////////////////////////////////////////
                              КОМИССИЯ
    //////////////////////////////////////////////////////////////*/

    /// @notice 1.00%. Константа, а не переменная: менять её нечем и некому.
    uint256 public constant FEE_BPS = 100;

    uint256 private constant BPS_DENOM = 10_000;

    /// @dev BPS_DENOM / FEE_BPS. Деление точное (10000 = 100·100), и это
    ///      используется в `maxEthIn`, где нужна обратная функция к комиссии.
    uint256 private constant FEE_DIV = BPS_DENOM / FEE_BPS;

    /*//////////////////////////////////////////////////////////////
                              АНТИ-СНАЙП
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Окно, в течение которого действует лимит на покупку.
     *
     * @dev ЧЕСТНАЯ ФОРМУЛИРОВКА (§4.5): это СМЯГЧЕНИЕ, а не защита. Лимит
     *      считается по адресу, и обойти его можно, разложив покупку по
     *      нескольким кошелькам. Он делает ровно одно: снайпер, скопировавший
     *      транзакцию развёртывания, не может выкупить существенную долю
     *      инвентаря одной транзакцией в первом же блоке. Чтобы забрать те же
     *      объёмы, ему придётся завести и профинансировать десятки адресов —
     *      это стоит газа, времени и видно в эксплорере, а обычные покупатели
     *      получают несколько блоков форы.
     *
     *      Час выбран как компромисс: меньше — и лимит не переживёт затор в
     *      сети, больше — и он мешает уже настоящему спросу. Лимит на адрес
     *      (а не на транзакцию) выбран потому, что лимит на транзакцию
     *      обходится тривиально — несколькими вызовами в том же блоке.
     */
    uint256 public constant ANTI_SNIPE_WINDOW = 1 hours;

    /// @notice 1% инвентаря = 10 000 000 токенов на адрес внутри окна.
    uint256 public constant ANTI_SNIPE_MAX = INVENTORY / 100;

    /*//////////////////////////////////////////////////////////////
                               IMMUTABLE
    //////////////////////////////////////////////////////////////*/

    /// @notice $MACLRN. Задаётся при развёртывании и не меняется.
    IERC20 public immutable token;

    /// @notice Получатель комиссии. immutable: функции смены не существует,
    ///         поэтому «создатель поменяет адрес на свой» здесь невозможно
    ///         не по обещанию, а по отсутствию кода.
    address public immutable feeRecipient;

    /// @notice Момент развёртывания. От него отсчитывается окно анти-снайпа.
    /// @dev Инвентарь обязан быть переведён в кривую той же транзакцией
    ///      (скрипт раскладки genesis, §7) — иначе окно истечёт до старта
    ///      торгов и смягчение §4.5 просто не сработает.
    uint256 public immutable startTime;

    /// @notice startTime + ANTI_SNIPE_WINDOW.
    uint256 public immutable antiSnipeEnd;

    /*//////////////////////////////////////////////////////////////
                               СОСТОЯНИЕ
    //////////////////////////////////////////////////////////////*/

    /// @notice Сколько токенов кривая продала за вычетом выкупленных обратно.
    ///         Это и есть точка `x` на кривой.
    uint256 public sold;

    /// @notice Резерв ETH, обеспечивающий выкуп. Только продажа токенов
    ///         обратно в кривую способна его уменьшить — других путей нет.
    uint256 public reserve;

    /// @notice Начисленная и ещё не выведенная комиссия. Уменьшается ровно
    ///         одной функцией — `withdrawFees`, и только в пользу feeRecipient.
    uint256 public feesAccrued;

    /// @notice Сколько комиссии уже ушло получателю. Нужен для сходимости
    ///         учёта: reserve + feesAccrued + feesWithdrawn == приход − расход.
    uint256 public feesWithdrawn;

    /// @notice Сколько токенов адрес купил внутри окна анти-снайпа.
    mapping(address => uint256) public boughtInWindow;

    /**
     * @notice Сколько токенов адрес купил у кривой и ещё не вернул ей.
     *         Это и есть его право на выкуп: продать в кривую можно ровно
     *         столько и ни токеном больше.
     *
     * @dev Разбор атаки, ради которой этот счётчик существует, — над `sell()`.
     *      Коротко: `sold` глобален и не знает, чьи это токены, а токен
     *      фунгибелен, поэтому без учёта по адресам резерв покупателя забирает
     *      любой держатель бесплатных токенов.
     *
     *      Право НЕ ПЕРЕНОСИТСЯ обычным `transfer` — оно живёт на адресе
     *      покупателя, а не на токенах. Иначе учёт пришлось бы вести в самом
     *      токене (хук на трансфере), то есть менять уже развёрнутый
     *      неизменяемый контракт, а заодно открывать право выкупа любому,
     *      кому токены просто переслали.
     *
     *      Ключевой инвариант: Σ boughtOf[всех] == sold. Он и делает проверку
     *      `amount <= sold` в `sell` формально лишней — см. там же.
     */
    mapping(address => uint256) public boughtOf;

    /*//////////////////////////////////////////////////////////////
                                СОБЫТИЯ
    //////////////////////////////////////////////////////////////*/

    event Bought(address indexed buyer, uint256 ethIn, uint256 fee, uint256 tokensOut, uint256 newSold);
    event Sold(address indexed seller, uint256 tokensIn, uint256 fee, uint256 ethOut, uint256 newSold);
    event FeesWithdrawn(address indexed recipient, uint256 amount);

    /*//////////////////////////////////////////////////////////////
                                ОШИБКИ
    //////////////////////////////////////////////////////////////*/

    error ZeroAddress();
    error ZeroAmount();
    error DeadlineExpired(uint256 deadline);
    error SlippageBuy(uint256 tokensOut, uint256 minTokensOut);
    error SlippageSell(uint256 ethOut, uint256 minEthOut);
    error ExceedsInventory(uint256 maxNetIn, uint256 netIn);
    error ExceedsSold(uint256 requested, uint256 available);

    /// @notice Попытка продать в кривую больше, чем этот адрес у неё купил.
    /// @dev Кривая — первичная продажа, а не биржа: она возвращает деньги
    ///      своим покупателям, а не выкупает токены с рынка. Токены из
    ///      genesis, награды стейкинга и купленное у другого держателя
    ///      продаются на DEX, а не сюда.
    /// @param requested Сколько адрес пытается продать.
    /// @param purchased Сколько он купил у кривой и ещё не вернул.
    error ExceedsPurchased(uint256 requested, uint256 purchased);
    error AntiSnipeLimit(uint256 requested, uint256 allowed);
    error OutOfRange(uint256 x);
    error NothingToWithdraw();
    error EthTransferFailed();

    /*//////////////////////////////////////////////////////////////
                              КОНСТРУКТОР
    //////////////////////////////////////////////////////////////*/

    /**
     * @param token_         Адрес уже развёрнутого $MACLRN.
     * @param feeRecipient_  Получатель комиссии, навсегда.
     *
     * @dev Инвентарь сюда не минтится и не забирается: токен неизменяем и
     *      весь выпущен в его конструкторе. Кривая получает свою долю обычным
     *      `transfer` из genesis — то есть до этого перевода контракт просто
     *      не может ничего продать, и `buy` отреветит на переводе токена.
     *      Проверять баланс в конструкторе бессмысленно (на момент
     *      развёртывания он ещё нулевой), а проверять его в `buy` — значит
     *      завести расчёт от balanceOf, чего §4.2 не допускает.
     */
    constructor(IERC20 token_, address feeRecipient_) {
        if (address(token_) == address(0) || feeRecipient_ == address(0)) revert ZeroAddress();

        token = token_;
        feeRecipient = feeRecipient_;
        startTime = block.timestamp;
        antiSnipeEnd = block.timestamp + ANTI_SNIPE_WINDOW;
    }

    /*//////////////////////////////////////////////////////////////
                           МАТЕМАТИКА КРИВОЙ
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Цена в точке `x` в ценовых единицах за один wei токена.
     *
     * @dev Деление на INVENTORY здесь округляет вниз, но на обоих концах
     *      диапазона оно ТОЧНОЕ (x = 0 и x = INVENTORY), а именно они и
     *      участвуют в утверждении «цена выросла ровно в e раз». Внутри
     *      диапазона эта функция никем не используется для денег — стоимость
     *      сделки считается по площади, без промежуточных округлений цены.
     */
    function priceAt(uint256 x) public pure returns (uint256) {
        if (x > INVENTORY) revert OutOfRange(x);
        return P0 + (SLOPE * x) / INVENTORY;
    }

    /// @notice Текущая цена одного ЦЕЛОГО токена (1e18 wei) в wei ETH.
    /// @dev Только для людей и интерфейсов. Ни один денежный расчёт через
    ///      неё не идёт: два деления подряд теряли бы точность там, где её
    ///      терять нельзя.
    function spotPrice() external view returns (uint256) {
        return (priceAt(sold) * 1e18) / PRICE_SCALE;
    }

    /**
     * @dev Числитель точной площади трапеции под кривой на [x1, x2]:
     *
     *          A(x1,x2) = (x2−x1)·(2·P0·S + SLOPE·(x1+x2)) / (2·S·PRICE_SCALE)
     *
     *      ОЦЕНКА ПЕРЕПОЛНЕНИЯ (§2.3, обязательна). Максимум достигается на
     *      x1 = 0, x2 = S = 1e27:
     *
     *          (1e27) · (4e44 + 3.43656365691809047e44)
     *            = 7.43656365691809047e71
     *
     *      против потолка uint256 = 1.157920892e77. Запас — 155 706 раз.
     *      Он не «примерно есть», а гарантирован жёстко: x1 ≤ x2 ≤ INVENTORY
     *      обеспечено тем, что `sold` не может превысить INVENTORY (покупка
     *      ограничена стоимостью остатка), а границу проверяет тест.
     *
     *      Нормировать x до целых токенов не понадобилось — точность в wei
     *      сохранена полностью.
     */
    function _numerator(uint256 x1, uint256 x2) private pure returns (uint256) {
        return (x2 - x1) * (COST_BASE + SLOPE * (x1 + x2));
    }

    /// @dev Площадь, округлённая ВНИЗ. Столько кривая ПЛАТИТ при выкупе.
    function _costFloor(uint256 x1, uint256 x2) private pure returns (uint256) {
        return _numerator(x1, x2) / COST_DENOM;
    }

    /// @dev Площадь, округлённая ВВЕРХ. Столько кривая БЕРЁТ при продаже.
    /// @dev Разнонаправленность округлений — это и есть доказательство
    ///      платёжеспособности: приход ≥ точной площади ≥ расход, а точная
    ///      площадь аддитивна, поэтому дробление сделок ничего не ломает.
    function _costCeil(uint256 x1, uint256 x2) private pure returns (uint256) {
        return (_numerator(x1, x2) + COST_DENOM - 1) / COST_DENOM;
    }

    /// @dev Комиссия, округлённая ВВЕРХ — как и всё остальное, в пользу
    ///      протокола. Побочный эффект важнее самой копейки: при ceil
    ///      выполняется netIn < msg.value строго для любого msg.value ≥ 1,
    ///      а значит круг «купил и сразу продал» убыточен даже на суммах в
    ///      единицы wei, где комиссия при округлении вниз была бы нулевой.
    function _fee(uint256 amount) private pure returns (uint256) {
        return (amount * FEE_BPS + BPS_DENOM - 1) / BPS_DENOM;
    }

    /**
     * @dev Сколько токенов купит `ethIn` (уже за вычетом комиссии) из точки `x`.
     *
     *      ПОЧЕМУ ДВОИЧНЫЙ ПОИСК, А НЕ КОРЕНЬ. Обращение трапеции — это
     *      квадратное уравнение, и в его дискриминанте стоит b², где
     *      b = S·P0 + SLOPE·x ≤ 5.44e44. Тогда b² ≈ 2.96e89 — это на двенадцать
     *      порядков выше потолка uint256. Пришлось бы нормировать x, терять
     *      точность и тащить в контракт с чужими деньгами собственный sqrt.
     *
     *      Двоичный поиск не приближает ответ, а находит его ТОЧНО: это
     *      максимальное d, при котором _costCeil(x, x+d) ≤ ethIn. Предикат
     *      монотонен, поэтому результат однозначен, а «округление вниз в
     *      пользу протокола» получается по построению, а не по формуле.
     *      Итераций не больше 90 (1e27 < 2^90), газ константный.
     *
     *      Сравнение развёрнуто без деления: ceil(n / D) ≤ ethIn равносильно
     *      n ≤ ethIn·D для целых. Это не микрооптимизация ради газа, а
     *      удаление деления из горячего цикла — там, где округление вверх
     *      выполнялось бы 90 раз подряд и каждое было бы лишним поводом
     *      ошибиться. Домножение безопасно: вызывающий уже отверг
     *      ethIn > _costCeil(x, INVENTORY), а это не больше TOTAL_RAISE
     *      ≈ 3.72e18, так что ethIn·D ≤ 7.44e71 — тот же максимум, что и
     *      у числителя площади, с запасом в 155 706 раз.
     */
    function _tokensFor(uint256 x, uint256 ethIn) private pure returns (uint256) {
        uint256 lo = 0;
        uint256 hi = INVENTORY - x;
        uint256 target = ethIn * COST_DENOM;
        // В числителе стоит (x2−x1)·(COST_BASE + SLOPE·(x1+x2)), где x1 = x и
        // x2 = x + mid. Разность равна mid, сумма — twoX + mid.
        uint256 twoX = x + x;

        while (lo < hi) {
            uint256 mid = (lo + hi + 1) >> 1;
            if (mid * (COST_BASE + SLOPE * (twoX + mid)) <= target) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        return lo;
    }

    /*//////////////////////////////////////////////////////////////
                                ПОКУПКА
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Купить $MACLRN за ETH по текущей цене кривой.
     *
     * @param minTokensOut Минимум токенов, иначе revert. Обязателен и обязан
     *                     быть больше нуля (§4.4): без него сэндвич-бот
     *                     зажимает покупателя между двумя своими сделками,
     *                     поднимает цену и продаёт ему по вершине.
     * @param deadline     Момент, после которого транзакция недействительна.
     *                     Тоже обязателен: транзакция, зависшая в мемпуле на
     *                     час, исполнится по совершенно другой цене.
     *
     * @dev ПОРЯДОК ДЕНЕГ (§3). Комиссия снимается с msg.value ДО того, как
     *      что-либо попадёт в резерв, и в резерв идёт только netIn. Так
     *      комиссия физически не может быть взята из резерва — не потому что
     *      мы этого не делаем, а потому что в момент её начисления резерв ещё
     *      не пополнен.
     *
     *      ЗДЕСЬ ЖЕ ВОЗНИКАЕТ ПРАВО ВЫХОДА. Покупка — единственное место, где
     *      растёт `boughtOf`, и растёт оно ровно у того, чей ETH лёг в резерв.
     *      Продать обратно в кривую можно только это (см. `sell`).
     *
     *      ПОЧЕМУ ПЕРЕПЛАТА РЕВЕРТИТ, А НЕ ВОЗВРАЩАЕТСЯ СДАЧЕЙ. Если ETH
     *      хватает больше чем на весь остаток инвентаря, вызов отклоняется.
     *      Альтернатива — вернуть разницу — потребовала бы внешнего перевода
     *      ETH прямо в `buy`, то есть ещё одной точки входа для реентранси
     *      в функции, которая иначе внешних вызовов ETH не делает вообще.
     *      Цена решения: последние токены покупаются не «на глазок», а по
     *      `maxEthIn()`, которая возвращает точную сумму до последнего wei.
     *      Молча оставлять переплату в резерве было бы хуже всего: это тихий
     *      грабёж невнимательного покупателя.
     *
     *      Checks-Effects-Interactions: весь стейт записан до `safeTransfer`.
     */
    function buy(uint256 minTokensOut, uint256 deadline)
        external
        payable
        nonReentrant
        returns (uint256 tokensOut)
    {
        if (block.timestamp > deadline) revert DeadlineExpired(deadline);
        if (msg.value == 0 || minTokensOut == 0) revert ZeroAmount();

        uint256 fee = _fee(msg.value);
        uint256 netIn = msg.value - fee;

        uint256 x = sold;
        uint256 maxNetIn = _costCeil(x, INVENTORY);
        if (netIn > maxNetIn) revert ExceedsInventory(maxNetIn, netIn);

        tokensOut = _tokensFor(x, netIn);
        if (tokensOut < minTokensOut) revert SlippageBuy(tokensOut, minTokensOut);

        if (block.timestamp < antiSnipeEnd) {
            uint256 acc = boughtInWindow[msg.sender] + tokensOut;
            if (acc > ANTI_SNIPE_MAX) revert AntiSnipeLimit(acc, ANTI_SNIPE_MAX);
            boughtInWindow[msg.sender] = acc;
        }

        // EFFECTS
        uint256 newSold = x + tokensOut;
        sold = newSold;
        reserve += netIn;
        feesAccrued += fee;
        // Право выкупа. Начисляется ровно на того, чьи деньги легли в резерв,
        // и ровно в том размере — отсюда Σ boughtOf == sold (см. `sell`).
        boughtOf[msg.sender] += tokensOut;

        emit Bought(msg.sender, msg.value, fee, tokensOut, newSold);

        // INTERACTIONS
        token.safeTransfer(msg.sender, tokensOut);
    }

    /*//////////////////////////////////////////////////////////////
                                ПРОДАЖА
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Вернуть кривой купленные у неё $MACLRN и забрать ETH.
     *
     * @dev ПОЧЕМУ ПРОДАВАТЬ МОЖЕТ ТОЛЬКО ПОКУПАТЕЛЬ И ТОЛЬКО СВОЁ.
     *      Это главное решение в контракте, и оно стоит того, чтобы разобрать
     *      его целиком — потому что «естественная» реализация здесь молча
     *      отдаёт деньги покупателей постороннему.
     *
     *      Наивно кривая проверяет только `amount <= sold`: продать обратно
     *      можно не больше, чем кривая вообще выпустила. Выглядит достаточным
     *      — обязательство равно `sold`, резерв его покрывает, инвариант
     *      платёжеспособности не нарушается никогда. Но `sold` ГЛОБАЛЕН: он не
     *      знает, чьи это токены, а токен фунгибелен и никакой памяти о
     *      происхождении не несёт. Значит право на резерв получает не тот, кто
     *      его наполнил, а любой, у кого есть нужное число токенов:
     *
     *          1. Покупатель вносит 1.000 ETH
     *             -> reserve = 0.990 ETH, sold = 374 503 207 786 020 143 771 730 036
     *          2. Держатель genesis-доли (маркетинг, резерв, казна) — он не
     *             платил кривой ничего — продаёт ей ровно столько же токенов
     *             -> забирает 0.9801 ETH, reserve = 1 wei, sold = 0
     *          3. Покупатель вызывает sell(...) -> РЕВЕРТ: sold уже ноль
     *             -> он вернул 0 ETH и остался с 374 млн токенов на руках
     *
     *      Формально всё «сошлось»: обязательство равнялось `sold`, резерв его
     *      покрывал, ни одна проверка не сработала. Инвариант выполнен —
     *      просто инвариант был не тот. Деньги покупателя забрал посторонний.
     *
     *      Масштаб не гипотетический: вне кривой сразу после раскладки genesis
     *      лежит 250 млн токенов (маркетинг 125M + резерв 62.5M + хвост
     *      62.5M), и ещё 718 млн MaclaurinEmission постепенно раздаст стейкерам —
     *      против инвентаря кривой в 1000 млн. Каждый такой токен был бы
     *      правом на чужой ETH.
     *
     *      Поэтому право выкупа именное: `boughtOf[msg.sender]` растёт при
     *      покупке и уменьшается при возврате. Каждый может вернуть кривой
     *      ровно то, что у неё купил, до последнего wei — и ни токеном больше.
     *      Резерв принадлежит покупателям, посторонний его не извлечёт.
     *
     *      Цена решения названа прямо: кривая перестаёт быть местом, куда
     *      можно продать ЛЮБЫЕ $MACLRN. Награды стейкинга, доли genesis и
     *      токены, купленные у другого держателя, продаются на вторичном
     *      рынке. Кривая — механизм первичной продажи с гарантией возврата
     *      денег покупателю, а не биржа, и подменять одно другим значит
     *      финансировать чужие выходы деньгами покупателей.
     *
     *      ЧТО ОСТАЛОСЬ ОТ §4.7. Условий по-прежнему нет ни одного сверх
     *      арифметически необходимых, и ни одного, зависящего от чьего-либо
     *      решения:
     *
     *        - `deadline` и `minEthOut` — защита самого продавца, он их и задаёт;
     *        - `amount != 0` — продажа нуля не операция;
     *        - `amount <= boughtOf[msg.sender]` — вернуть больше, чем купил,
     *          значит забрать чужое; это разобрано выше;
     *        - `amount <= sold` — второй рубеж, см. ниже.
     *
     *      Ни паузы, ни белых/чёрных списков, ни кулдауна, ни налога на
     *      продажу, ни чьей-либо подписи. Покупатель, вошедший через кривую,
     *      выходит через неё всегда и полностью. Проверить это можно за
     *      десять секунд — тело функции целиком перед глазами.
     *
     *      ПОЧЕМУ `amount <= sold` ОСТАВЛЕН, ХОТЯ НЕДОСТИЖИМ. Из
     *      Σ boughtOf == sold следует amount ≤ boughtOf[msg.sender] ≤ sold,
     *      то есть эта проверка сработать не может. Она оставлена намеренно:
     *      защита в глубину стоит одного SLOAD, а рассуждение о равенстве
     *      сумм — целой страницы. Если равенство когда-нибудь нарушит правка,
     *      здесь будет revert, а не вычитание в минус.
     *
     *      ПОЧЕМУ РЕЗЕРВА ХВАТИТ ВСЕГДА. `reserve ≥ A(0, sold)` — инвариант,
     *      который держится на разнонаправленном округлении (см. _costCeil).
     *      Здесь списывается floor(A(newSold, sold)) ≤ A(newSold, sold), а
     *      площадь аддитивна, поэтому после вычитания снова
     *      reserve ≥ A(0, newSold). Индукция по всем сделкам, без исключений.
     *
     *      REENTRANCY (§4.3). Выплата — внешний вызов на произвольный адрес,
     *      то есть классика The DAO. Три независимых рубежа: весь стейт
     *      записан до вызова, `nonReentrant`, и перевод через `call{value:}`
     *      с проверкой результата, а не `transfer` (лимит в 2300 газа сломал
     *      бы контракты-кошельки и превратил бы их владельцев в заложников).
     */
    function sell(uint256 amount, uint256 minEthOut, uint256 deadline)
        external
        nonReentrant
        returns (uint256 ethOut)
    {
        if (block.timestamp > deadline) revert DeadlineExpired(deadline);
        if (amount == 0 || minEthOut == 0) revert ZeroAmount();

        uint256 purchased = boughtOf[msg.sender];
        if (amount > purchased) revert ExceedsPurchased(amount, purchased);

        uint256 x = sold;
        if (amount > x) revert ExceedsSold(amount, x);

        uint256 newSold = x - amount;
        uint256 gross = _costFloor(newSold, x);
        uint256 fee = _fee(gross);
        ethOut = gross - fee;
        if (ethOut < minEthOut) revert SlippageSell(ethOut, minEthOut);

        // EFFECTS
        sold = newSold;
        reserve -= gross;
        feesAccrued += fee;
        // Право выкупа гасится ровно на возвращённое: Σ boughtOf == sold
        // переживает и частичные продажи, и любое их чередование с покупками.
        boughtOf[msg.sender] = purchased - amount;

        emit Sold(msg.sender, amount, fee, ethOut, newSold);

        // INTERACTIONS
        token.safeTransferFrom(msg.sender, address(this), amount);
        // Низкоуровневый вызов здесь предписан §4.3 и не является упущением:
        // `transfer` с лимитом в 2300 газа сломал бы контракты-кошельки, то
        // есть превратил бы часть держателей в заложников. Результат
        // проверяется строкой ниже, реентранси закрыт `nonReentrant` и CEI.
        // slither-disable-next-line low-level-calls
        (bool ok,) = msg.sender.call{value: ethOut}("");
        if (!ok) revert EthTransferFailed();
    }

    /*//////////////////////////////////////////////////////////////
                               КОМИССИЯ
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Отправить накопленную комиссию получателю.
     *
     * @dev Вызов открыт для всех — и это не недосмотр, а то же решение, что
     *      в `sweepToRemainderVault` у MaclaurinEmission: получатель зашит в
     *      immutable, сумма ограничена счётчиком, выбирать здесь нечего.
     *      Посторонний вызов может только заплатить за газ создателя.
     *
     *      `reserve` этой функцией недостижим в принципе: она читает только
     *      `feesAccrued`. Инвариант §5.7 «у создателя нет способа изъять
     *      резерв» держится не на проверке, а на отсутствии кода, который
     *      мог бы это сделать.
     */
    function withdrawFees() external nonReentrant {
        uint256 amount = feesAccrued;
        if (amount == 0) revert NothingToWithdraw();

        // EFFECTS
        feesAccrued = 0;
        feesWithdrawn += amount;

        emit FeesWithdrawn(feeRecipient, amount);

        // INTERACTIONS
        // Та же причина, что в `sell`: получателем комиссии вполне может быть
        // мультисиг, а он в 2300 газа не укладывается.
        // slither-disable-next-line low-level-calls
        (bool ok,) = feeRecipient.call{value: amount}("");
        if (!ok) revert EthTransferFailed();
    }

    /*//////////////////////////////////////////////////////////////
                             VIEW-ФУНКЦИИ
    //////////////////////////////////////////////////////////////*/

    /// @notice Сколько токенов ещё не продано.
    function remainingInventory() public view returns (uint256) {
        return INVENTORY - sold;
    }

    /// @notice Сколько ETH (без комиссии) нужно, чтобы купить `amount` токенов.
    /// @dev Округление вверх — ровно то же, что применит `buy`.
    function quoteBuyCost(uint256 amount) public view returns (uint256) {
        uint256 x = sold;
        if (amount > INVENTORY - x) revert OutOfRange(amount);
        return _costCeil(x, x + amount);
    }

    /// @notice Сколько ETH вернёт кривая за `amount` токенов ДО комиссии.
    /// @dev Округление вниз — ровно то же, что применит `sell`. Это и есть
    ///      величина из инварианта §5.1: reserve обязан её покрывать при
    ///      amount == sold.
    /// @dev Это котировка кривой, а не разрешение на продажу: право адреса
    ///      ограничено `boughtOf(msg.sender)`, и здесь оно не проверяется —
    ///      функция не знает, кто спрашивает. Интерфейсу перед вызовом `sell`
    ///      надо смотреть на `boughtOf`.
    function quoteSellGross(uint256 amount) public view returns (uint256) {
        uint256 x = sold;
        if (amount > x) revert ExceedsSold(amount, x);
        return _costFloor(x - amount, x);
    }

    /// @notice Что вернёт `buy` при данном msg.value, без исполнения.
    function previewBuy(uint256 ethIn) external view returns (uint256 tokensOut, uint256 fee, uint256 netIn) {
        fee = _fee(ethIn);
        netIn = ethIn - fee;
        uint256 x = sold;
        uint256 maxNetIn = _costCeil(x, INVENTORY);
        if (netIn > maxNetIn) revert ExceedsInventory(maxNetIn, netIn);
        tokensOut = _tokensFor(x, netIn);
    }

    /// @notice Что вернёт `sell` за `amount` токенов, без исполнения.
    function previewSell(uint256 amount) external view returns (uint256 ethOut, uint256 fee) {
        uint256 gross = quoteSellGross(amount);
        fee = _fee(gross);
        ethOut = gross - fee;
    }

    /**
     * @notice Наибольший msg.value, который `buy` ещё примет прямо сейчас.
     *
     * @dev Нужна, потому что переплата ревертит (см. `buy`), а купить остаток
     *      инвентаря целиком должно быть возможно точно, а не подбором.
     *
     *      Обращаем комиссию. Пусть net — стоимость всего остатка, а
     *      f(V) = V − ceil(V/FEE_DIV) — сколько из V дойдёт до резерва.
     *      Запишем V = FEE_DIV·q + r, 0 ≤ r < FEE_DIV. Тогда
     *      f(V) = (FEE_DIV−1)·q + (r > 0 ? r−1 : 0), то есть при фиксированном
     *      q функция f пробегает отрезок [(FEE_DIV−1)q, (FEE_DIV−1)q + FEE_DIV−2].
     *      Максимум V с f(V) ≤ net берётся при q = net / (FEE_DIV−1) и
     *      r = net % (FEE_DIV−1) + 1: остаток не превышает FEE_DIV−2, поэтому
     *      такое r всегда допустимо. Подставляя и сокращая
     *      FEE_DIV·q = (FEE_DIV−1)·q + q = (net − r + 1) + q, получаем
     *
     *          V = net + net / (FEE_DIV − 1) + 1
     *
     *      Форма без умножения после деления выбрана не только ради
     *      читаемости: `a * (b / c)` теряет точность на округлении, и
     *      статические анализаторы справедливо ругаются на такой порядок.
     *      Здесь он алгебраически лишний.
     */
    function maxEthIn() external view returns (uint256) {
        uint256 net = _costCeil(sold, INVENTORY);
        return net + net / (FEE_DIV - 1) + 1;
    }
}
