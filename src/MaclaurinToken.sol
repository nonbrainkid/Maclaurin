pragma solidity =0.8.24;

import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";

/**
 * @title  MaclaurinToken ($MACLRN)
 * @notice ERC-20, чей общий сапплай равен числу e, домноженному на 10^27.
 *
 *         e = Σ 1/n!  =  1/0! + 1/1! + 1/2! + 1/3! + ...
 *
 *         Первые два члена ряда (1/0! + 1/1! = 2) — это GENESIS, он существует
 *         с нулевого блока. Хвост ряда (Σ 1/n! для n ≥ 2) — это EMISSION_POOL,
 *         который распределяется контрактом эмиссии по эпохам.
 *
 * @dev    БЕЗОПАСНОСТЬ — ключевое свойство этого контракта в том, чего в нём НЕТ:
 *
 *         - нет функции `mint` (весь сапплай минтится один раз в конструкторе);
 *         - нет `Ownable`, нет `owner`, нет ролей и привилегий;
 *         - нет proxy / upgradeable-паттерна;
 *         - нет пауз, блэклистов, комиссий на трансфер и хуков.
 *
 *         Почему это важно. Самый частый способ рагпула — не эксплойт, а вполне
 *         легальная функция `mint(address,uint256) onlyOwner`. Владелец печатает
 *         себе триллион токенов и продаёт в пул; аудит такой контракт пропустит,
 *         потому что там нет уязвимости — там есть задокументированное полномочие.
 *         Единственная реальная защита от этого — чтобы такой функции физически
 *         не существовало в байткоде. Таймлок, мультисиг и обещания команды — это
 *         про доверие, а не про гарантию.
 *
 *         Следствие: после развёртывания `totalSupply()` неизменен НАВСЕГДА.
 *         Уменьшить его тоже нельзя — публичной `burn` здесь тоже нет; любой,
 *         кто хочет сжечь свои токены, может отправить их на нулевой адрес
 *         обычным `transfer`.
 */
contract MaclaurinToken is ERC20 {
    /*//////////////////////////////////////////////////////////////
                                КОНСТАНТЫ
    //////////////////////////////////////////////////////////////*/

    /// @notice floor(e × 10^27) — общий сапплай в базовых единицах (wei).
    ///         2 718 281 828.459045235360287471 токенов.
    uint256 public constant TOTAL_SUPPLY = 2_718_281_828_459_045_235_360_287_471;

    /// @notice Члены ряда n=0 и n=1: 1/0! + 1/1! = 2. Ровно 2 000 000 000 токенов
    ///         (73.576% сапплая). Не фармится — существует с нулевого блока.
    uint256 public constant GENESIS = 2_000_000_000_000_000_000_000_000_000;

    /// @notice Хвост ряда, Σ 1/n! для n ≥ 2. 718 281 828.459045235360287471 токенов
    ///         (26.424% сапплая). Распределяется контрактом эмиссии.
    uint256 public constant EMISSION_POOL = TOTAL_SUPPLY - GENESIS;

    /*//////////////////////////////////////////////////////////////
                              КОНСТРУКТОР
    //////////////////////////////////////////////////////////////*/

    /**
     * @param genesisRecipient  Получатель GENESIS (ликвидность, казна проекта).
     * @param emissionContract  Адрес MaclaurinEmission — получатель EMISSION_POOL.
     *
     * @dev Оба `_mint` вызываются здесь и больше нигде. OZ ERC20._mint сам
     *      реверит на нулевом адресе получателя (ERC20InvalidReceiver), поэтому
     *      отдельная проверка `!= address(0)` была бы дублированием.
     */
    constructor(address genesisRecipient, address emissionContract) ERC20("Maclaurin Series", "MACLRN") {
        _mint(genesisRecipient, GENESIS);
        _mint(emissionContract, EMISSION_POOL);

        // Инвариант, зафиксированный в байткоде на этапе развёртывания.
        // Если арифметика констант когда-нибудь разъедется — контракт просто
        // не развернётся, вместо того чтобы уехать в мейннет неправильным.
        assert(totalSupply() == TOTAL_SUPPLY);
    }
}
