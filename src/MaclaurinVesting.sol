pragma solidity =0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

/**
 * @title  MaclaurinVesting
 * @notice Казна $MACLRN под замком до одной даты. Держит токены и отдаёт их
 *         бенефициару не раньше `unlockTime` — целиком, одной операцией.
 *
 * @dev    БЕЗОПАСНОСТЬ — как и в токене, ключевое свойство здесь в том, чего
 *         в контракте НЕТ:
 *
 *         - нет функции досрочного вывода — ни для деплоера, ни для кого;
 *         - нет `owner`, нет ролей, нет `Ownable`;
 *         - нет способа сменить `beneficiary` или подвинуть `unlockTime`;
 *         - нет proxy, нет `selfdestruct`, нет произвольного `call`;
 *         - нет `receive`/`fallback` — контракт не принимает ETH.
 *
 *         Почему так. Обычный «вестинг» на рынке — это контракт с функцией
 *         `emergencyWithdraw() onlyOwner`: юридически всё честно, функция
 *         задокументирована, а на практике казна разблокирована с первого дня.
 *         Держатель не может отличить такой контракт от настоящего замка,
 *         не читая код. Здесь отличать нечего: функции нет в байткоде, и это
 *         проверяется сканированием селекторов в тесте, а не обещанием.
 *
 *         ПРО ГРАФИК. Одна дата разблокировки, без ступеней и без линейного
 *         начисления (PHASE4-SPEC.md §6). Ступенчатый график по ряду 1/n!
 *         обсуждался и отклонён: каждая дополнительная ветка — это ещё одно
 *         место, где может быть спрятана ошибка, и ещё один абзац, который
 *         придётся объяснять. Простота здесь не лень, а функция доверия.
 *
 *         ПРО СОСТОЯНИЕ. У контракта нет ни одной изменяемой переменной —
 *         только три immutable, зашитых в байткод. Поэтому здесь нечего
 *         рассинхронизировать и незачем ставить `ReentrancyGuard`: «сколько
 *         отдать» вычисляется из живого баланса в момент вызова, а получатель
 *         жёстко зафиксирован. Повторный вход в `release()` во время перевода
 *         увидел бы нулевой баланс и отревертил, а если бы и не увидел —
 *         токены всё равно ушли бы по тому же самому адресу.
 *
 *         ПРО `balanceOf(address(this))`. В MaclaurinEmission такой расчёт был бы
 *         дырой (donation раздувал бы награды и делал принципал стейкеров
 *         выплачиваемым), поэтому там весь учёт идёт по явным счётчикам. Здесь
 *         наоборот: единственный получатель — бенефициар, и любой чужой перевод
 *         на этот адрес просто увеличивает его выплату. Раздуть нечего.
 */
contract MaclaurinVesting {
    using SafeERC20 for IERC20;

    /*//////////////////////////////////////////////////////////////
                               ПАРАМЕТРЫ
    //////////////////////////////////////////////////////////////*/

    /// @notice Токен казны. immutable — подменить нельзя.
    IERC20 public immutable token;

    /// @notice Единственный возможный получатель. immutable: функции смены
    ///         бенефициара не существует, поэтому адрес, попавший сюда при
    ///         развёртывании, останется здесь навсегда.
    address public immutable beneficiary;

    /// @notice Момент разблокировки (unix-время). По §6 — старт эмиссии
    ///         плюс 175 дней, то есть конец полного цикла эмиссии.
    uint256 public immutable unlockTime;

    /*//////////////////////////////////////////////////////////////
                                 СОБЫТИЯ
    //////////////////////////////////////////////////////////////*/

    event Released(address indexed beneficiary, uint256 amount);

    /*//////////////////////////////////////////////////////////////
                                 ОШИБКИ
    //////////////////////////////////////////////////////////////*/

    error ZeroAddress();
    error UnlockTimeInPast();
    error StillLocked(uint256 unlockTime);
    error NothingToRelease();

    /*//////////////////////////////////////////////////////////////
                              КОНСТРУКТОР
    //////////////////////////////////////////////////////////////*/

    /**
     * @param token_        Адрес $MACLRN.
     * @param beneficiary_  Получатель казны после разблокировки.
     * @param unlockTime_   Момент разблокировки (unix-время), строго в будущем.
     *
     * @dev Прошедшая дата ревертит, а не принимается «как уже разблокировано».
     *      Причина та же, что у StartTimeInPast в MaclaurinEmission: развернуть
     *      казну, которая открыта с нулевого блока, можно только по ошибке —
     *      опечатка в скрипте или протухший таймстамп между подготовкой и
     *      отправкой транзакции. Исправить это потом нельзя: контракт
     *      неизменяем, а токены в нём уже лежат. Дешевле не развернуться.
     */
    constructor(IERC20 token_, address beneficiary_, uint256 unlockTime_) {
        if (address(token_) == address(0) || beneficiary_ == address(0)) revert ZeroAddress();
        if (unlockTime_ <= block.timestamp) revert UnlockTimeInPast();

        token = token_;
        beneficiary = beneficiary_;
        unlockTime = unlockTime_;
    }

    /*//////////////////////////////////////////////////////////////
                             ЕДИНСТВЕННОЕ ДЕЙСТВИЕ
    //////////////////////////////////////////////////////////////*/

    /**
     * @notice Переводит весь баланс казны бенефициару. До `unlockTime` ревертит.
     *
     * @dev Вызов открыт для всех, и это не недосмотр. Получатель зашит в
     *      immutable, поэтому «кто нажал» не влияет ни на сумму, ни на адрес:
     *      посторонний вызов может только заплатить за газ бенефициара.
     *      Ограничение `onlyBeneficiary` не добавило бы безопасности, зато
     *      добавило бы способ отказа — если бенефициаром окажется контракт
     *      или мультисиг, неспособный отправить произвольный вызов, казна
     *      осталась бы запертой навсегда.
     *
     *      `block.timestamp` здесь безопасен, несмотря на общее правило. Его
     *      манипулируемость валидатором — единицы секунд; срок измеряется
     *      месяцами, и сдвиг на минуту ничего не меняет по существу.
     *
     *      Порядок checks-effects-interactions соблюдён вырожденно: изменяемого
     *      состояния нет вообще, событие эмитится до внешнего вызова.
     */
    function release() external {
        if (block.timestamp < unlockTime) revert StillLocked(unlockTime);

        uint256 amount = token.balanceOf(address(this));
        if (amount == 0) revert NothingToRelease();

        emit Released(beneficiary, amount);
        token.safeTransfer(beneficiary, amount);
    }
}
